+// Drag interactions on the fields, in trial (PX-127): the dev server's switcher (DragLab.svelte)
+// sets one for every field on the page. Empty in production, where fields keep click and hover.
+export type Drag = '' | 'wake' | 'bow' | 'draw' | 'sling' | 'pan' | 'combo';
+export const lab = $state({ drag: '' as Drag });
diff --git a/src/lib/components/DragLab.svelte b/src/lib/components/DragLab.svelte
new file mode 100644
index 0000000..1c05bef
--- /dev/null
+++ b/src/lib/components/DragLab.svelte
@@ -0,0 +1,30 @@
+<script lang="ts">
+  // Dev only (PX-127): picks the drag interaction every field on the page uses, to try them on the
+  // real pages. Keys 0 to 6 switch too; the choice is kept in this browser.
+  import { onMount } from 'svelte';
+  import { lab, type Drag } from '$lib/dragLab.svelte';
+  import { motion } from '$lib/motion.svelte';
+  const MODES: [Drag, string][] = [['', 'Off'], ['wake', 'Wake'], ['bow', 'Bow wave'], ['draw', 'Draw'], ['sling', 'Slingshot'], ['pan', 'Pan'], ['combo', 'Combo']];
+  function set(d: Drag) { lab.drag = d; try { localStorage.setItem('tim-drag-lab', d); } catch {} }
+  onMount(() => { try { lab.drag = (localStorage.getItem('tim-drag-lab') ?? 'combo') as Drag; } catch {} });
+  function onKey(e: KeyboardEvent) {
+    const t = e.target as HTMLElement | null;
+    if (e.metaKey || e.ctrlKey || e.altKey || t?.closest('input, textarea, [contenteditable]')) return;
+    const n = Number(e.key); if (Number.isInteger(n) && n >= 0 && n < MODES.length) set(MODES[n][0]);
+  }
+</script>
+<svelte:window onkeydown={onKey} />
+<div class="drag-lab panel lbl" role="group" aria-label="Drag interaction (dev)">
+  <span class="dim">Drag</span>
+  {#each MODES as [d, name], i (d)}<button type="button" aria-pressed={lab.drag === d} onclick={() => set(d)}><b>{i}</b>{name}</button>{/each}
+  {#if !motion.on}<span class="warn">Motion is off</span>{/if}
+</div>
+<style>
+.drag-lab{position:fixed;left:var(--s2);bottom:var(--s2);z-index:var(--z-skip);display:flex;flex-wrap:wrap;align-items:center;gap:0;padding:0 0 0 var(--s2);max-width:calc(100vw - 2 * var(--s2))}
+.drag-lab>span{margin-right:var(--s1)}
+.drag-lab button{padding:var(--pad-s)}
+.drag-lab button b{font-weight:400;opacity:var(--dim);margin-right:var(--s1)}
+.drag-lab button[aria-pressed=true]{background:var(--accent);color:var(--on-accent)}
+@media(hover:hover){.drag-lab button:not([aria-pressed=true]):hover{background:var(--paper);color:var(--fg)}}
+.drag-lab .warn{padding:var(--pad-s);background:var(--accent);color:var(--on-accent)}
+</style>
