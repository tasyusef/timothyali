diff --git a/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/gestures.mjs b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/gestures.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7faa565ef208a45287ba89729330156acec60af3
--- /dev/null
+++ b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/gestures.mjs
@@ -0,0 +1,38 @@
+import {paths,key} from './tasks.mjs';
+const base='http://127.0.0.1:4173';
+const fields=paths.filter(p=>p==='/'||p.startsWith('/work/')&&p!=='/work/'||['/toolbox/','/contact/','/nope/'].includes(p));
+async function gesture(pg){
+ const box=await pg.locator('.band').first().boundingBox();
+ const w=pg.viewportSize().width;
+ const start={x:Math.min(w-40,box.x+box.width-40),y:Math.max(140,box.y+80)};
+ const end={x:Math.max(60,w*.28),y:Math.min(620,box.y+box.height-40)};
+ await pg.mouse.move(start.x,start.y);await pg.mouse.down();await pg.mouse.move(end.x,end.y,{steps:18});await pg.waitForTimeout(1550);
+ const held=await pg.locator('.band-bg canvas').first().evaluate(c=>c.toDataURL());
+ await pg.mouse.up();await pg.waitForTimeout(220);
+ return {start,end,selected:await pg.evaluate(()=>getSelection()?.toString()),held};
+}
+async function setMotion(pg,on){
+ if(await pg.locator('.site').getAttribute('data-motion')===(on?'on':'off'))return;
+ await pg.getByRole('button',{name:'Settings',exact:true}).click();await pg.getByRole('button',{name:/Motion/}).click();await pg.keyboard.press('Escape');
+}
+export async function run(){
+ await page.setViewportSize({width:1440,height:960});await page.goto(base);await setMotion(page,true);const rows=[];
+ for(const p of fields){
+  await page.goto(base+p);await page.waitForTimeout(1500);
+  const before=await page.locator('.band-bg canvas').first().evaluate(c=>c.toDataURL());
+  const moving=await gesture(page);await page.screenshot({path:out+'field-'+key(p)+'-release.png'});
+  const nav=page.locator('header nav a[href="/work/"]');await nav.click();await page.waitForTimeout(400);const click=page.url();
+  await page.goto(base+p);await setMotion(page,false);await page.waitForTimeout(400);
+  const stillBefore=await page.locator('.band-bg canvas').first().evaluate(c=>c.toDataURL());await gesture(page);await page.waitForTimeout(300);const stillAfter=await page.locator('.band-bg canvas').first().evaluate(c=>c.toDataURL());
+  rows.push({p,w:1440,onChanged:before!==moving.held,selection:moving.selected,click,offStatic:stillBefore===stillAfter,start:moving.start,end:moving.end});
+  await setMotion(page,true);
+ }
+ const reduced=await browser.newContext({viewport:{width:1440,height:960},reducedMotion:'reduce'});const rp=await reduced.newPage();
+ for(const p of fields){await rp.goto(base+p);await rp.waitForTimeout(500);const a=await rp.locator('.band-bg canvas').first().evaluate(c=>c.toDataURL());await gesture(rp);const b=await rp.locator('.band-bg canvas').first().evaluate(c=>c.toDataURL());rows.push({p,w:1440,reduced:true,motion:await rp.locator('.site').getAttribute('data-motion'),static:a===b});}
+ await reduced.close();await fs.writeFile(out+'gestures.json',JSON.stringify(rows,null,2));return rows;
+}
+export async function touch(){
+ const tc=await browser.newContext({viewport:{width:390,height:844},hasTouch:true,isMobile:true,reducedMotion:'no-preference'});const tp=await tc.newPage();const cdp=await tc.newCDPSession(tp),rows=[];
+ for(const p of fields){await tp.goto(base+p);await tp.waitForTimeout(300);await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x:330,y:650}]});for(let i=1;i<=12;i++){await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x:330,y:650-i*32}]});await tp.waitForTimeout(20);}await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});await tp.waitForTimeout(200);rows.push({p,y:await tp.evaluate(()=>scrollY),height:await tp.evaluate(()=>document.documentElement.scrollHeight)});}
+ await tc.close();await fs.writeFile(out+'touch-swipes.json',JSON.stringify(rows,null,2));return rows;
+}
diff --git a/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/interactions.mjs b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/interactions.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8126d8355b87326f802831df9288146259f240bb
--- /dev/null
+++ b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/interactions.mjs
@@ -0,0 +1,47 @@
+import {paths,key} from './tasks.mjs';
+const base='http://127.0.0.1:4173';
+const result=[];
+const record=async(name,data)=>{result.push({name,...data});await fs.writeFile(out+'interactions.json',JSON.stringify(result,null,2));};
+export async function links(w){
+ await page.setViewportSize({width:w,height:960});
+ const clicks=[];
+ for(const p of paths){
+  await page.goto(base+p);await page.waitForTimeout(150);
+  const links=await page.locator('a').evaluateAll(es=>es.map(e=>({href:e.getAttribute('href'),text:e.innerText})).filter(e=>e.href&&!e.href.startsWith('mailto:')&&!e.href.includes('/resume/')&&!e.href.includes('/download/')));
+  for(const a of links){
+   await page.goto(base+p);await page.waitForTimeout(70);
+   const l=page.locator('a').filter({has:undefined});
+   const target=page.locator('a').filter({visible:true});
+   const exact=page.locator('a').filter({hasText:a.text}).filter({visible:true});
+   const byHref=page.locator('a').filter({visible:true});
+   let match=null;for(const e of await byHref.all())if(await e.getAttribute('href')===a.href){match=e;break;}
+   if(!match){clicks.push({p,...a,skipped:'hidden'});continue;}
+   if(/^https?:/.test(a.href)){
+     const dest=new URL(a.href);await page.route(a.href,route=>route.fulfill({status:200,contentType:'text/html',body:'<title>Audit destination intercepted</title>External destination intercepted for audit.'}));
+   }
+   try{await match.click({timeout:5000});await page.waitForTimeout(110);clicks.push({p,...a,url:page.url(),focus:await page.evaluate(()=>document.activeElement?.tagName),scroll:await page.evaluate(()=>scrollY)});}
+   catch(e){clicks.push({p,...a,error:e.message.slice(0,300)});}
+  }
+ }
+ await record('links',{w,clicks});return {w,count:clicks.length,errors:clicks.filter(c=>c.error)};
+}
+export async function contact(w){
+ await page.setViewportSize({width:w,height:960});let count=0,mode='failed';
+ await page.route('**/api/contact',async route=>{count++;await new Promise(r=>setTimeout(r,800));if(mode==='network')return route.abort();await route.fulfill({status:mode==='sent'?200:502,contentType:'application/json',body:JSON.stringify(mode==='sent'?{ok:true}:{ok:false,error:'send-failed'})});});
+ await page.goto(base+'/contact/');await page.waitForTimeout(200);
+ const send=page.getByRole('button',{name:'Send',exact:true});
+ await send.click();const empty={focus:await page.evaluate(()=>document.activeElement.name),errors:await page.locator('.note').allTextContents(),count};
+ await page.screenshot({path:out+'contact-'+w+'-empty.png',fullPage:true});
+ await page.getByRole('textbox',{name:'Name',exact:true}).fill('Audit Example');
+ await page.getByRole('textbox',{name:'Email',exact:true}).fill('bad-address');
+ await page.getByRole('textbox',{name:'Your message',exact:true}).fill('Intercepted audit message. No real email.');
+ await send.click();const invalid={focus:await page.evaluate(()=>document.activeElement.name),errors:await page.locator('.note').allTextContents(),count};
+ await page.getByRole('textbox',{name:'Email',exact:true}).fill('audit@example.com');
+ await send.click();await page.waitForTimeout(100);const sending={label:await page.locator('.send button').innerText(),ariaDisabled:await page.locator('.send button').getAttribute('aria-disabled'),focus:await page.evaluate(()=>document.activeElement.innerText)};
+ await page.screenshot({path:out+'contact-'+w+'-sending.png',fullPage:true});
+ await page.waitForTimeout(900);const failed={status:await page.locator('#contact-status').innerText(),value:await page.locator('textarea').inputValue(),focus:await page.evaluate(()=>document.activeElement.innerText)};
+ await page.screenshot({path:out+'contact-'+w+'-failed.png',fullPage:true});
+ mode='sent';await page.locator('textarea').focus();await page.keyboard.press('Meta+Enter');await page.waitForTimeout(950);const sent={status:await page.locator('#contact-status').innerText(),name:await page.locator('input[name=name]').inputValue(),message:await page.locator('textarea').inputValue(),count};
+ await page.screenshot({path:out+'contact-'+w+'-sent.png',fullPage:true});await page.unroute('**/api/contact');
+ await record('contact',{w,empty,invalid,sending,failed,sent});return {w,empty,invalid,sending,failed,sent};
+}
diff --git a/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/tasks.mjs b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/tasks.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8ea48ae04623f2618f34fd31a6edc556654f3e28
--- /dev/null
+++ b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/tasks.mjs
@@ -0,0 +1,40 @@
+export const paths=['/','/work/','/work/parc/','/work/xrpcafe/','/work/firstledger/','/work/do-androids-dream/','/work/jade-aesthetics/','/work/firststrike/','/work/toolbox/','/toolbox/','/toolbox/lockup/','/toolbox/palette/','/toolbox/specimen/','/toolbox/convert/','/toolbox/agents/','/contact/','/nope/'];
+export const key=p=>p==='/'?'home':p.replace(/^\//,'').replaceAll('/','_');
+export const survey=[];
+export async function scan(w,theme){
+  await page.setViewportSize({width:w,height:960});
+  await page.evaluate(t=>localStorage.setItem('tim-theme',t),theme);
+  const rows=[];
+  for(const p of paths){
+    await page.goto('http://127.0.0.1:4173'+p); await page.waitForTimeout(200);
+    await page.evaluate(()=>document.fonts.ready);
+    if(w===1440||w===390){
+      const h=await page.evaluate(()=>document.documentElement.scrollHeight);
+      for(let y=0;y<h;y+=740){await page.evaluate(y=>scrollTo({top:y,behavior:'instant'}),y);await page.waitForTimeout(30);}
+      await page.screenshot({path:out+key(p)+w+'-'+theme+'-bottom.png'});
+      await page.evaluate(()=>scrollTo({top:0,behavior:'instant'}));
+    }
+    const s=await page.evaluate(()=>({title:document.title,h1:document.querySelector('h1')?.innerText,sw:document.documentElement.scrollWidth,w:innerWidth,height:document.documentElement.scrollHeight,fields:document.querySelectorAll('.band-bg canvas').length,
+      overflow:[...document.querySelectorAll('main *')].filter(e=>e.getBoundingClientRect().width>0&&getComputedStyle(e).position!=='absolute'&&(e.getBoundingClientRect().right>innerWidth+2||e.getBoundingClientRect().left < -2)).slice(0,15).map(e=>({tag:e.tagName,c:e.className,t:e.innerText?.slice(0,90),rect:e.getBoundingClientRect().toJSON()})),
+      text:document.querySelector('main')?.innerText,
+      controls:[...document.querySelectorAll('main a,main button,main input,main select,main textarea')].map(e=>({tag:e.tagName,text:e.innerText,aria:e.getAttribute('aria-label'),href:e.getAttribute('href')}))}));
+    await page.screenshot({path:out+key(p)+w+'-'+theme+'.png',fullPage:true});
+    rows.push({p,w,theme,...s});
+  }
+  survey.push(...rows); await fs.writeFile(out+'survey.json',JSON.stringify(survey,null,2));
+  return rows.map(s=>({p:s.p,h:s.height,overflow:s.overflow.length,sw:s.sw,fields:s.fields}));
+}
+export async function keyboard(w){
+  await page.setViewportSize({width:w,height:960});const results=[];
+  for(const p of paths){
+    await page.goto('http://127.0.0.1:4173'+p);await page.waitForTimeout(180);
+    const n=await page.locator('a,button,input,select,textarea,[tabindex="0"]').count();const stops=[];
+    for(let i=0;i<n+3;i++){
+      await page.keyboard.press('Tab');
+      const f=await page.evaluate(()=>{const e=document.activeElement,r=e.getBoundingClientRect(),c=getComputedStyle(e);return {tag:e.tagName,text:(e.getAttribute('aria-label')||e.innerText||e.getAttribute('name')||'').slice(0,110),href:e.getAttribute('href'),outline:c.outline,rect:r.toJSON(),y:scrollY,hidden:e.closest('[aria-hidden="true"]')!==null,top:document.querySelector('.nav-chrome').getBoundingClientRect().bottom};});
+      stops.push(f);if(i>1&&f.href==='#main')break;
+    }
+    results.push({p,w,stops});
+  }
+  await fs.writeFile(out+'keyboard-'+w+'.json',JSON.stringify(results,null,2));return results.map(r=>({p:r.p,stops:r.stops.length,issues:r.stops.filter(s=>s.hidden||s.outline.includes('none')||s.rect.right>w+1)}));
+}

diff --git a/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs
new file mode 100644
