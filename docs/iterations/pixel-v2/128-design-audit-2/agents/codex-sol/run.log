   158	  .point-text:global(.hold){position:sticky;top:calc(var(--chrome-height) + var(--s4))}
   159	}
   160	@media(max-width:900px){.point,.list{grid-template-columns:100%}}
   161	@media(max-width:700px){
   162	  /* on phones the head is 240px at least, its title at the foot (0185) */
   163	  main :global(.head){padding-top:var(--s3);padding-bottom:var(--s8);min-height:240px;justify-content:flex-end}
   164	  .grow{grid-template-columns:100%}
   165	  /* phone screenshots and squares two to a line, not one per screen (PX-49) */
   166	  .grow.tiles{grid-template-columns:repeat(2,round(down,calc((100% - 16px) / 2),2px))} /* equal columns, so a line's figures floor to one height */
   167	  .hero-row,.point,.list,.next{padding-top:var(--s6)}
