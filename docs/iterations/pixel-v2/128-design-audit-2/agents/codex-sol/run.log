+  for(const p of paths){
+    await page.goto('http://127.0.0.1:4173'+p); await page.waitForTimeout(200);
+    await page.evaluate(()=>document.fonts.ready);
+    if(w===1440||w===390){
+      const h=await page.evaluate(()=>document.documentElement.scrollHeight);
+      for(let y=0;y<h;y+=740){await page.evaluate(y=>scrollTo({top:y,behavior:'instant'}),y);await page.waitForTimeout(30);}
+      await page.screenshot({path:out+key(p)+w+'-'+theme+'-bottom.png'});
+      await page.evaluate(()=>scrollTo({top:0,behavior:'instant'}));
+    }
+    const s=await page.evaluate(()=>({title:document.title,h1:document.querySelector('h1')?.innerText,sw:document.documentElement.scrollWidth,w:innerWidth,height:document.documentElement.scrollHeight,fields:document.querySelectorAll('.band-bg canvas').length,
+      overflow:[...document.querySelectorAll('main *')].filter(e=>e.getBoundingClientRect().width>0&&getComputedStyle(e).position!=='absolute'&&(e.getBoundingClientRect().right>innerWidth+2||e.getBoundingClientRect().left < -2)).slice(0,15).map(e=>({tag:e.tagName,c:e.className,t:e.innerText?.slice(0,90),rect:e.getBoundingClientRect().toJSON()})),
+      text:document.querySelector('main')?.innerText,
+      controls:[...document.querySelectorAll('main a,main button,main input,main select,main textarea')].map(e=>({tag:e.tagName,text:e.innerText,aria:e.getAttribute('aria-label'),href:e.getAttribute('href')}))}));
+    await page.screenshot({path:out+key(p)+w+'-'+theme+'.png',fullPage:true});
+    rows.push({p,w,theme,...s});
+  }
+  survey.push(...rows); await fs.writeFile(out+'survey.json',JSON.stringify(survey,null,2));
+  return rows.map(s=>({p:s.p,h:s.height,overflow:s.overflow.length,sw:s.sw,fields:s.fields}));
+}
+export async function keyboard(w){
+  await page.setViewportSize({width:w,height:960});const results=[];
+  for(const p of paths){
+    await page.goto('http://127.0.0.1:4173'+p);await page.waitForTimeout(180);
+    const n=await page.locator('a,button,input,select,textarea,[tabindex="0"]').count();const stops=[];
+    for(let i=0;i<n+3;i++){
+      await page.keyboard.press('Tab');
+      const f=await page.evaluate(()=>{const e=document.activeElement,r=e.getBoundingClientRect(),c=getComputedStyle(e);return {tag:e.tagName,text:(e.getAttribute('aria-label')||e.innerText||e.getAttribute('name')||'').slice(0,110),href:e.getAttribute('href'),outline:c.outline,rect:r.toJSON(),y:scrollY,hidden:e.closest('[aria-hidden="true"]')!==null,top:document.querySelector('.nav-chrome').getBoundingClientRect().bottom};});
+      stops.push(f);if(i>1&&f.href==='#main')break;
+    }
+    results.push({p,w,stops});
+  }
+  await fs.writeFile(out+'keyboard-'+w+'.json',JSON.stringify(results,null,2));return results.map(r=>({p:r.p,stops:r.stops.length,issues:r.stops.filter(s=>s.hidden||s.outline.includes('none')||s.rect.right>w+1)}));
+}

diff --git a/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..18d44816c836063df2026989ef56f61a54add73d
--- /dev/null
+++ b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs
@@ -0,0 +1,20 @@
+import { chromium } from '@playwright/test';
+import fs from 'node:fs/promises';
+import readline from 'node:readline';
+const out = new URL('.', import.meta.url).pathname;
+const browser = await chromium.launch({ channel: 'chrome' });
+const ctx = await browser.newContext({ viewport: { width: 1440, height: 960 }, reducedMotion: 'no-preference' });
+const page = await ctx.newPage();
+const log = [];
+page.on('pageerror', e => log.push({ error: e.message, url: page.url() }));
+Object.assign(globalThis, { browser, ctx, page, fs, out, log });
+await page.goto('http://127.0.0.1:4173/');
+console.log('READY', await page.title());
+const AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;
+for await (const code of readline.createInterface({ input: process.stdin })) {
+  if (!code.trim()) continue;
+  if (code === 'CLOSE') { await browser.close(); break; }
+  await fs.appendFile(out + 'commands.jsonl', JSON.stringify({time:new Date().toISOString(), code}) + '\n');
+  try { console.log(JSON.stringify(await new AsyncFunction(code)())); }
+  catch (e) { console.log('ERROR', e.stack); }
+}
diff --git a/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/contrast.mjs b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/contrast.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..65baa8ddec74245de29a5f2c20814ab03d93b142
--- /dev/null
+++ b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/contrast.mjs
@@ -0,0 +1,14 @@
+import fs from 'node:fs/promises';
+const out=new URL('.',import.meta.url).pathname;
+const data=JSON.parse(await fs.readFile(out+'final-checks.json'));
+const rgb=s=>s.match(/[\d.]+/g).slice(0,3).map(Number);
+const blend=(f,b,a)=>f.map((v,i)=>v*a+b[i]*(1-a));
+const lum=c=>c.map(n=>{const v=n/255;return v<=.04045?v/12.92:((v+.055)/1.055)**2.4}).reduce((n,v,i)=>n+v*[.2126,.7152,.0722][i],0);
+const ratio=(f,b)=>{const a=lum(f),c=lum(b);return (Math.max(a,c)+.05)/(Math.min(a,c)+.05)};
+const apca=(f,b)=>{const y=c=>c.reduce((n,v,i)=>n+(v/255)**2.4*[.2126729,.7151522,.072175][i],0);let t=y(f),g=y(b);if(t<.022)t+=(.022-t)**1.414;if(g<.022)g+=(.022-g)**1.414;if(Math.abs(g-t)<.0005)return 0;const s=g>t?(g**.56-t**.57)*1.14:(g**.65-t**.62)*1.14;return g>t?(s<.1?0:(s-.027)*100):(s>-.1?0:(s+.027)*100)};
+const rows=[];
+for(const r of data.filter(r=>r.kind==='colors')){
+ const c=r.colors,p=rgb(c.paper),f=rgb(c.fg),a=rgb(c.accent),t=rgb(c.accentText),pa=rgb(c.panelAccent);
+ for(const [name,fg,bg] of [['body',f,p],['dim label',blend(f,p,c.dim),p],['panel dim label',blend(p,f,c.panelDim),f],['accent type and focus',t,p],['panel focus',pa,f],['button',rgb('rgb(24,24,20)'),a]])rows.push({theme:r.theme,name,fg,bg,ratio:+ratio(fg,bg).toFixed(2),Lc:+apca(fg,bg).toFixed(1)});
+}
+await fs.writeFile(out+'contrast.json',JSON.stringify(rows,null,2));console.log(rows);
