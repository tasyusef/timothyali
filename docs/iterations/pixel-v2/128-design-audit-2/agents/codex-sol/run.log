+ const held=await pg.locator('.band-bg canvas').first().evaluate(c=>c.toDataURL());
+ await pg.mouse.up();await pg.waitForTimeout(220);
+ return {start,end,selected:await pg.evaluate(()=>getSelection()?.toString()),held};
+}
