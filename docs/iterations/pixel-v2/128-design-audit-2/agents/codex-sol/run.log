+ for(const theme of ['dark','light']){
+  await page.goto(base+'/contact/');await page.evaluate(t=>{localStorage.setItem('tim-theme',t);localStorage.setItem('tim-motion','off')},theme);await page.reload();
+  const colors=await page.evaluate(()=>{const r=getComputedStyle(document.documentElement),rgb=v=>{const e=document.createElement('i');e.style.color=v;document.body.append(e);const c=getComputedStyle(e).color;e.remove();return c;};return {paper:rgb(r.getPropertyValue('--paper')),fg:rgb(r.getPropertyValue('--fg')),accent:rgb(r.getPropertyValue('--accent')),accentText:rgb(r.getPropertyValue('--accent-text')),panelAccent:rgb(r.getPropertyValue('--accent-on-fg')),dim:parseFloat(r.getPropertyValue('--dim')),panelDim:parseFloat(r.getPropertyValue('--dim-on-fg'))};});
+  rows.push({kind:'colors',theme,colors});await page.getByRole('button',{name:'Settings',exact:true}).focus();await page.keyboard.press('Enter');await page.keyboard.press('Tab');await page.screenshot({path:out+'settings-focus-'+theme+'.png'});await page.keyboard.press('Escape');
+ }
