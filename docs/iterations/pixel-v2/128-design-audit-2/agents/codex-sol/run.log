+ for(const [name,fn] of [['theme',async()=>{await page.getByRole('button',{name:'Settings',exact:true}).click();await page.getByRole('button',{name:/Theme/}).click();}],['route',async()=>{await page.locator('header nav a[href="/work/"]').click();}]]){
