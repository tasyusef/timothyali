+ for(const p of ['/work/parc/','/work/xrpcafe/','/work/do-androids-dream/']){await page.goto(base+p);const button=page.locator('.clip button').first();await button.focus();await page.keyboard.press('Enter');await page.waitForTimeout(400);const play={label:await button.getAttribute('aria-label'),paused:await page.locator('.clip video').first().evaluate(v=>v.paused),focused:await button.evaluate(e=>e===document.activeElement)};await page.keyboard.press('Space');await page.waitForTimeout(100);rows.push({kind:'video',p,play,pause:{label:await button.getAttribute('aria-label'),paused:await page.locator('.clip video').first().evaluate(v=>v.paused),focused:await button.evaluate(e=>e===document.activeElement)}});}
