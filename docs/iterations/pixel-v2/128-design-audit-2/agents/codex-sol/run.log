/* PARC Pixel is inlined (0206): 1.7 KB a weight, it arrived 2.6 s after first paint on slow 3G,
   and with font-display:block every nav label and chip was blank until then */
@font-face{font-family:'PARC Pixel Web';src:url('data:font/woff2;base64,') format('woff2');font-weight:400;font-display:block}
@font-face{font-family:'PARC Pixel Bold Web';src:url('data:font/woff2;base64,') format('woff2');font-weight:700;font-display:block}

/* Fallbacks sized like the web faces (0207): until a face arrives the page is set in a system
   face scaled to the same width and line box, so nothing moves when it swaps in (the Home name
   wrapped to two lines in Times and jumped 148px; a tool page's facts reflowed). Measured in
   Chrome on macOS; the overrides are divided by size-adjust, which scales them too. Where the
   local face is missing (Android) the stack falls through to the generic face as before. */
@font-face{font-family:'Jacquard 24 fallback';src:local('Times New Roman'),local('TimesNewRomanPSMT');size-adjust:82.26%;ascent-override:96.04%;descent-override:25.53%;line-gap-override:0%}
@font-face{font-family:'Jersey 15 fallback';src:local('Arial'),local('ArialMT');size-adjust:84.71%;ascent-override:92.08%;descent-override:25.97%;line-gap-override:0%}
@font-face{font-family:'Press Start 2P fallback';src:local('Courier New'),local('CourierNewPSMT');size-adjust:166.64%;ascent-override:60.01%;descent-override:0%;line-gap-override:0%}
/* In-page jumps (the hero's “Explore the tools”, a Work row from Home) ease when motion is on;
   the skip link scrolls instantly on its own (0098). The class lives on .site, so :has reaches it. */
:root:has(.site.motion){scroll-behavior:smooth}
:root{font-family:var(--face-root);font-size:27px;line-height:32px;color:var(--fg);background:var(--paper);font-synthesis:none;-webkit-font-smoothing:none;text-rendering:optimizeSpeed;-webkit-tap-highlight-color:transparent} /* the press states (0099) are the tap feedback; no browser flash over them (0206) */
*{box-sizing:border-box}body{margin:0;min-height:100vh}
h1,h2,h3,p,figure,dl,dd{margin:0}h1,h2,h3{font-weight:400}
a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;cursor:pointer;background:none;border:0;padding:0}
::selection{background:var(--fg);color:var(--paper)}
/* One focus ring: the accent as type on whatever ground the element sits on (0106). */
:focus-visible{outline:var(--focus-ring);outline-offset:2px}
canvas{image-rendering:pixelated}
pre{margin:0;font:inherit}
main{display:block}
.sr-only{position:absolute!important;width:1px!important;height:1px!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important}

/* the one blink in the system — the status-strip cursor and Decode's share it */
@keyframes blink{from{opacity:1}to{opacity:0}}

/* ------------------------------------------------------------------
   The dither wipe (0100). Anything that arrives on the site comes through the
   checker in three whole steps, coarse to fine: one pixel in four at 8px, two in
   four at 4px, three in four at 2px, then all. Nothing eases; `steps(3)` samples
   exactly the three keyframes. `dither-out` is the same road the other way.
   Used by the theme flip and the route change (view transitions, below) and by
   images as they load (Picture.svelte, the Toolbox demo). Motion [off] uses none.
   ------------------------------------------------------------------ */
@keyframes dither-in{
  0%{mask-image:conic-gradient(#000 0 25%,#0000 0);mask-size:16px 16px}
  33.334%{mask-image:repeating-conic-gradient(#000 0 25%,#0000 0 50%);mask-size:8px 8px}
  66.667%{mask-image:conic-gradient(#000 0 75%,#0000 0);mask-size:4px 4px}
  100%{mask-image:none}
}
@keyframes dither-out{
  0%{mask-image:conic-gradient(#000 0 75%,#0000 0);mask-size:4px 4px}
  33.334%{mask-image:repeating-conic-gradient(#000 0 25%,#0000 0 50%);mask-size:8px 8px}
  66.667%{mask-image:conic-gradient(#000 0 25%,#0000 0);mask-size:16px 16px}
  100%{mask-image:linear-gradient(#0000,#0000)}
}
/* The browser's cross-fade is replaced outright: no blend, no easing, the old page
   sits under the new. `.vt-theme` and `.vt-route` are set on <html> by the layout for
   the length of one transition; without the API or with motion off nothing runs. */
::view-transition-image-pair(root){isolation:auto}
::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
/* Theme (0100): the new page dithers in over the old, three steps at the Decode cadence. */
:root.vt-theme::view-transition-new(root){animation:var(--wipe-in)}
/* Route (0104): the old page dithers out to the field at full density, the new one dithers
   in from it; six fast steps, one beat. The field is the texture's own 16px checker. */
:root.vt-route::view-transition{background:var(--paper) repeating-conic-gradient(var(--field-ink) 0 25%,transparent 0 50%) 0 0/var(--cell-texture) var(--cell-texture)}
:root.vt-route::view-transition-old(root){animation:dither-out calc(3 * var(--step-fast)) steps(3) both}
/* masked away until its turn: a backwards fill would show its first step during the delay */
:root.vt-route::view-transition-new(root){mask-image:linear-gradient(#0000,#0000);animation:dither-in calc(3 * var(--step-fast)) steps(3) calc(3 * var(--step-fast)) forwards}

/* ------------------------------------------------------------------
   The page scrollbar, in the system (0107): a 16px track on the card dither, an 8px
   thumb in the foreground colour — the cursor block, tall — that goes to the accent when
   reached for or pressed; square corners, no buttons. Native behaviour is kept. Styling
   it turns macOS overlay bars into classic ones, so the bar takes its 16px from the
   viewport on every platform. Firefox has only the two colours: a flat track at the
   dither's average.
   ------------------------------------------------------------------ */
::-webkit-scrollbar{width:16px;height:16px}
::-webkit-scrollbar-track{background:var(--paper) var(--surface-card)}
::-webkit-scrollbar-thumb{background:var(--fg);border:4px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-thumb:hover,::-webkit-scrollbar-thumb:active{background-color:var(--accent)}
::-webkit-scrollbar-button{display:none}
::-webkit-scrollbar-corner{background:var(--paper)}
@supports not selector(::-webkit-scrollbar){:root{scrollbar-color:var(--fg) color-mix(in srgb,var(--fg) 14%,var(--paper))}}

diff --git a/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..18d44816c836063df2026989ef56f61a54add73d
--- /dev/null
+++ b/docs/iterations/pixel-v2/128-design-audit-2/agents/codex-sol/browser.mjs
@@ -0,0 +1,20 @@
+import { chromium } from '@playwright/test';
+import fs from 'node:fs/promises';
+import readline from 'node:readline';
+const out = new URL('.', import.meta.url).pathname;
+const browser = await chromium.launch({ channel: 'chrome' });
+const ctx = await browser.newContext({ viewport: { width: 1440, height: 960 }, reducedMotion: 'no-preference' });
+const page = await ctx.newPage();
+const log = [];
+page.on('pageerror', e => log.push({ error: e.message, url: page.url() }));
+Object.assign(globalThis, { browser, ctx, page, fs, out, log });
+await page.goto('http://127.0.0.1:4173/');
+console.log('READY', await page.title());
+const AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;
+for await (const code of readline.createInterface({ input: process.stdin })) {
+  if (!code.trim()) continue;
+  if (code === 'CLOSE') { await browser.close(); break; }
+  await fs.appendFile(out + 'commands.jsonl', JSON.stringify({time:new Date().toISOString(), code}) + '\n');
+  try { console.log(JSON.stringify(await new AsyncFunction(code)())); }
+  catch (e) { console.log('ERROR', e.stack); }
+}
