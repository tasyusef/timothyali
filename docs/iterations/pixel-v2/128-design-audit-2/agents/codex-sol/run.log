+ if(touch){await p.getByRole('button',{name:'Send the link to your computer',exact:true}).click();results.push({name:'send-link-success',status:await p.locator('.on-phone [role=status]').innerText(),clipboard:await p.evaluate(()=>navigator.clipboard.readText())});
