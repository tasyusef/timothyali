+  await fs.writeFile(out+'keyboard-'+w+'.json',JSON.stringify(results,null,2));return results.map(r=>({p:r.p,stops:r.stops.length,issues:r.stops.filter(s=>s.hidden||s.outline.includes('none')||s.rect.right>w+1)}));
+}

