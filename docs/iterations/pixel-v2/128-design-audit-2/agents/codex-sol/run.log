+  for(let i=0;i<10;i++){await page.keyboard.press('Tab');stops.push(await page.evaluate(()=>({tag:document.activeElement.tagName,text:(document.activeElement.getAttribute('aria-label')||document.activeElement.innerText||document.activeElement.name).slice(0,120),y:scrollY,top:document.activeElement.getBoundingClientRect().top})));if(i===7||i===8)await page.screenshot({path:out+'order-'+key(p)+w+'-'+i+'.png'});}
+  records.push({kind:'focus-order',p,w,stops});
