+  return rows.map(s=>({p:s.p,h:s.height,overflow:s.overflow.length,sw:s.sw,fields:s.fields}));
+}
+export async function keyboard(w){
+  await page.setViewportSize({width:w,height:960});const results=[];
+  for(const p of paths){
