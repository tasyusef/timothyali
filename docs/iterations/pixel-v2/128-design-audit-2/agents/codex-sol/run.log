<script lang="ts">
  // The readout strip over each example (0210; written four times): the tool's folder, a count.
  let { path, count }: { path: string; count: string } = $props();
</script>
<div class="demo-readout lbl"><span class="demo-path"><span class="pre">~/Toolbox/</span>{path}</span><span>{count}</span></div>
<script lang="ts">
  // The app's bottom bar (0210; written four times): Back, the middle (a count or the steps),
  // and the tool's action, disabled because exporting happens in the app unless `act` is given.
  import type { Snippet } from 'svelte';
  import Arrow from '$lib/components/Arrow.svelte';
  let { label = 'Export', backDisabled = true, onback, act, children }:
    { label?: string; backDisabled?: boolean; onback?: () => void; act?: Snippet; children: Snippet } = $props();
</script>
<div class="toolbar lbl">
  <button type="button" class="btn lbl" disabled={backDisabled} onclick={onback}><Arrow dir="left" />Back</button>
  {@render children()}
  {#if act}{@render act()}{:else}<button type="button" class="demo-act lbl" disabled title="Export happens in the app">{label}<Arrow /></button>{/if}
</div>
<script lang="ts">
  // One row of the export tree, recursing into its children (the app's `lockup/PlanRow`,
  // without the file thumbnails). Versions open, PRINT/WEB closed until clicked; the
  // expansion sets live with the tree's owner so they survive a rebuild of the plan.
  import type { SvelteSet } from 'svelte/reactivity';
  import PlanRow from './PlanRow.svelte';
  import SwatchDot from './SwatchDot.svelte';
  import { type PlanNode, isFile } from './plan';
  let { node, depth, userExpanded, userCollapsed, palette }: { node: PlanNode; depth: number; userExpanded: SvelteSet<string>; userCollapsed: SvelteSet<string>; palette: string[] } = $props();
  const defaultExpandDepth = 2;
  const expanded = $derived(userExpanded.has(node.id) ? true : userCollapsed.has(node.id) ? false : depth < defaultExpandDepth);
  const swatches = $derived.by((): string[] => {
    if (node.name === 'Black') return ['#000000'];
    if (node.name === 'White') return ['#FFFFFF'];
    if (node.name.includes('Color')) return palette;
    return [];
  });
  const toggle = (): void => {
    if (expanded) { userExpanded.delete(node.id); userCollapsed.add(node.id); }
    else { userCollapsed.delete(node.id); userExpanded.add(node.id); }
  };
</script>
{#if isFile(node)}
  <div class="tree-row" style:padding-left={`calc(${depth} * var(--s2))`}><span class="mono"></span><span class="body name dim">{node.name}</span></div>
{:else}
  <button type="button" class="tree-row" onclick={toggle} aria-expanded={expanded} style:padding-left={`calc(${depth} * var(--s2))`}>
    <span class="mono dim" aria-hidden="true">{expanded ? 'v' : '>'}</span>
    <span class="lbl name" class:dim={depth !== 1}>{node.name}/</span>
    {#if swatches.length}<span class="swatches">{#each swatches as hex, i (`${hex}-${i}`)}<SwatchDot {hex} size={16} />{/each}</span>{/if}
    <span class="lbl dim">{node.fileCount}</span>
  </button>
  {#if expanded}{#each node.children as child (child.id)}<PlanRow node={child} depth={depth + 1} {userExpanded} {userCollapsed} {palette} />{/each}{/if}
{/if}
/* ------------------------------------------------------------------
   Layer 2 — semantic tokens. What a primitive means on this site.
   Only these names should appear in chrome/layout/blocks/type and in the
   routes; primitives are referenced here and (deliberately) in one place
   outside: the discipline-label plate, which must not invert with the theme.
   ------------------------------------------------------------------ */
:root{
  /* ground and type */
  --paper:var(--ink);
  --fg:var(--white);
  --accent:var(--yellow);        /* fills: cursors, active nav, action blocks */
  --accent-text:var(--yellow);   /* the accent as type; deepens on the light ground (0075) */
  --accent-on-fg:var(--yellow-deep);   /* the accent as type on a --fg panel: the other ground, the other value (0106) */
  --accent-field:var(--yellow);        /* the accent drawn in an ASCII field; a touch darker on the light ground (0108) */
  --on-accent:var(--ink);
  --dim:.75;              /* opacity, not a colour; .65 on the light ground, where .55 was 3.8:1 at 12.5px (0206).
                             White on ink at .55 was APCA Lc 40, under the 60 a label needs; .75 is Lc 63 (PX-125) */
  --dim-on-fg:.65;        /* --dim on a --fg panel: the other ground, the other value (0210) */

  /* Button padding (0097, named 0210): a label's ink sits 1px high and carries a 2px trailing
     bearing, so the padding is 1 more below than above and 2 less on the right. Small is a 32px
     block (nav items, the hint chip, the demo's buttons), medium a 48px one. */
  --pad-s:9px 14px 7px 16px;
  --pad-m:17px 14px 15px 16px;

  /* page frame */
  --gutter:32px;
  --col-side:448px;       /* the side column: Contact's form, Home's closing action (0210) */
  --header-height:64px;   /* default; the layout overrides it inline with the measured height */

  /* surfaces */
  --surface-card:repeating-conic-gradient(var(--tint-rim) 0 25%,transparent 0 50%) 0 0/4px 4px;
  --surface-card-hover:repeating-conic-gradient(color-mix(in srgb,var(--fg) 26%,transparent) 0 25%,transparent 0 50%) 0 0/8px 8px;
  --texture-fallback-opacity:.35;  /* the CSS checker shown before a canvas has drawn */
  --field-ink:color-mix(in srgb,var(--fg) 40%,var(--paper));   /* the ASCII field: recessed, well behind the type (0091) */

  /* fg tints, light to strong (0210: the fine and major ones were the Grid overlay's, named --grid-*) */
  --tint-fine:color-mix(in srgb,var(--fg) 12%,transparent);   /* the admin tables' rules */
  --tint-rim:color-mix(in srgb,var(--fg) 14%,transparent);    /* the card dither, the examples' rims */
  --tint-major:color-mix(in srgb,var(--fg) 22%,transparent);  /* the admin chart's base */
  --tint-rule:color-mix(in srgb,var(--fg) 30%,transparent);   /* the examples' field and slider rules */

  /* the sticky chrome: header 64 and status strip 32; on phones the two-row header alone, 104 (0210) */
  --chrome-height:96px;
  /* the three-frame dither wipe an image or theme arrives with (@keyframes dither-in, base.css) */
  --wipe-in:dither-in calc(3 * var(--step)) steps(3) both;
  /* the keyboard focus ring (base.css, the Toolbox examples' fields); .panel declares it again (PX-125) */
  --focus-ring:2px solid var(--accent-text);

  /* layering, low to high */
  --z-band-bg:0;   /* a band's programmatic background */
  --z-band:1;      /* everything else inside a band */
  --z-chrome:2;    /* header and status strip inside the sticky wrapper */
  --z-nav:50;      /* the sticky wrapper itself */
  --z-skip:99;     /* the skip link, above everything */

  color-scheme:dark;
}
:root[data-theme=light]{--dim:.65;--dim-on-fg:.75;--paper:var(--white);--fg:var(--ink);color-scheme:light;--accent-text:var(--yellow-deep);--accent-on-fg:var(--yellow);--accent-field:var(--yellow-field)}
@media(max-width:700px){:root{--gutter:16px;--chrome-height:104px}}
/* asked for more contrast: dimming is the site's only low-contrast text, so it goes (PX-125) */
@media(prefers-contrast:more){:root,:root[data-theme=light]{--dim:1;--dim-on-fg:1}}

