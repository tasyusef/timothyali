        <div class="role"><span class="meta">SIZES</span>{#each narrow ? [2] : [2, 1, 0] as step (step)}<p style:font={`${f.sizes[step]} ${f.family}`} style:text-transform={f.caps ? 'uppercase' : 'none'}>{line}</p>{/each}</div>
