+export async function crossText(){
+ const rows=[];await page.setViewportSize({width:1440,height:960});await page.goto(base);await page.evaluate(()=>{localStorage.setItem('tim-motion','on')});
+ for(const p of paths){await page.goto(base+p);if(!await page.locator('.band').count())continue;await page.waitForTimeout(1200);
+  const spot=await page.locator('h1').evaluate(e=>{const walk=document.createTreeWalker(e,NodeFilter.SHOW_TEXT);while(walk.nextNode()){const n=walk.currentNode;if(!n.textContent.trim()||n.parentElement.closest('.sr-only,[aria-hidden="true"]:not(.decode>span)'))continue;const r=document.createRange();r.selectNodeContents(n);for(const b of r.getClientRects())if(b.width>5&&b.height>5&&b.top>100&&b.bottom<900)return {x:b.left+Math.min(20,b.width/2),y:b.top+b.height/2};}const r=e.getBoundingClientRect();return{x:r.x+50,y:r.y+r.height/2};});
+  await page.mouse.move(1400,140);await page.mouse.down();await page.mouse.move(spot.x,spot.y,{steps:14});const link=page.locator('.band a').first();if(await link.count()){await link.scrollIntoViewIfNeeded();const b=await link.boundingBox();await page.mouse.move(b.x+b.width/2,b.y+b.height/2,{steps:10});}else await page.mouse.move(1000,32,{steps:10});await page.mouse.move(spot.x,spot.y,{steps:10});await page.waitForTimeout(1500);await page.mouse.up();rows.push({p,selection:await page.evaluate(()=>getSelection()?.toString())});
+ }
+ await fs.writeFile(out+'cross-text.json',JSON.stringify(rows,null,2));return rows;
+}
