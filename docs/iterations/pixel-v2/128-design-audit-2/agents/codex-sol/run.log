.fill-main{display:flex;flex-direction:column}
.fill-main>.band{flex:1}
/* Over a field the pointer is the site's own: a 16px bitmap crosshair, hotspot in its open
   centre cell, drawn in the foreground colour of the theme (0103). Links, buttons and fields
   inside a band keep the browser's hand and I-beam. */
.band{cursor:url(/cursor/field-dark.png) 7 7,crosshair;cursor:-webkit-image-set(url(/cursor/field-dark.png) 1x,url(/cursor/field-dark@2x.png) 2x) 7 7,crosshair;cursor:image-set(url(/cursor/field-dark.png) 1x,url(/cursor/field-dark@2x.png) 2x) 7 7,crosshair}
