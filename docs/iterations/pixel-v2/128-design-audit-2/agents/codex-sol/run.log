+ await p.locator('.tool-picker button').nth(3).focus();await p.keyboard.press('Space');await p.waitForTimeout(500);
+ for(const label of ['PNG','TIFF','PDF','500'])await p.getByRole('button',{name:label,exact:true}).click();
+ await p.getByRole('slider',{name:'Compression'}).focus();await p.keyboard.press('ArrowRight');await p.keyboard.press('End');await p.waitForTimeout(400);await snap('convert-all');
+ const downloaded=[];await p.route('**/download/**',async route=>{downloaded.push(route.request().url());await route.fulfill({status:204,body:''});});
+ const downloads=await p.locator('a[href^="/download/"]').all();for(const link of downloads)await link.click();results.push({name:'downloads',downloaded});
+ if(touch){await p.getByRole('button',{name:'Send the link to your computer',exact:true}).click();results.push({name:'send-link-success',status:await p.locator('.on-phone [role=status]').innerText(),clipboard:await p.evaluate(()=>navigator.clipboard.readText())});
