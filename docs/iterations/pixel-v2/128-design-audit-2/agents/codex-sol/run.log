.site{position:relative;min-height:100vh;display:flex;flex-direction:column}
.site>main{flex:1}
section{position:relative;padding:0 var(--gutter)}

/* full-bleed programmatic background for a band */
/* The field's accent is `--accent-field` (0108): the brand yellow, a touch darker on the light
   ground. It is decoration, not type, so the deepened `--accent-text` does not apply to it. */
.band-bg{position:absolute;inset:0;z-index:var(--z-band-bg);pointer-events:none;color:var(--field-ink);--accent-text:var(--accent-field)}
.band-bg>*{height:100%}
