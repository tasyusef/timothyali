   140	/* Points (PX-52): the text in the left third, the screens in the rest. A point without
   141	   screens is one column, its text at the reading measure. */
   142	.point{display:grid;grid-template-columns:round(down,calc((100% - 32px) / 3),8px) 1fr;gap:var(--s4);align-items:start;padding-top:var(--s12)}
