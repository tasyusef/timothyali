+ await p.goto(base+'/toolbox/');await p.waitForTimeout(400);const results=[];
+ const snap=async(name)=>{await p.screenshot({path:out+name+'-'+w+(touch?'-touch':'')+'.png',fullPage:true});const data=await p.evaluate(()=>({sw:document.documentElement.scrollWidth,w:innerWidth,focus:document.activeElement.outerHTML.slice(0,300),overflow:[...document.querySelectorAll('.demo *')].filter(e=>e.getBoundingClientRect().right>innerWidth+1).map(e=>({t:e.innerText?.slice(0,70),tag:e.tagName,c:e.className,r:e.getBoundingClientRect().toJSON()})).slice(0,15)}));results.push({name,...data});};
