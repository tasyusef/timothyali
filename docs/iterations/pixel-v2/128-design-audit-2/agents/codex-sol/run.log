+import {paths,key} from './tasks.mjs';
+const base='http://127.0.0.1:4173';
+export async function run(){
+ const records=[];await page.setViewportSize({width:1440,height:960});
+ for(const p of paths){await page.goto(base+p);await page.keyboard.press('Tab');await page.keyboard.press('Enter');records.push({kind:'skip',p,active:await page.evaluate(()=>document.activeElement.id),y:await page.evaluate(()=>scrollY)});}
+ await page.goto(base);await page.getByRole('button',{name:'Settings',exact:true}).focus();await page.keyboard.press('Space');await page.keyboard.press('Tab');const focused=await page.evaluate(()=>document.activeElement.innerText);await page.keyboard.press('Space');const off=await page.locator('.site').getAttribute('data-motion');await page.keyboard.press('Tab');await page.keyboard.press('Enter');const theme=await page.locator('html').getAttribute('data-theme');await page.keyboard.press('Escape');const restore=await page.evaluate(()=>document.activeElement.getAttribute('aria-label'));await page.locator('header nav a[href="/work/"]').focus();await page.keyboard.press('Enter');await page.waitForTimeout(500);records.push({kind:'settings',focused,off,theme,restore,nextTheme:await page.locator('html').getAttribute('data-theme'),nextMotion:await page.locator('.site').getAttribute('data-motion')});
+ for(const [p,w] of [['/work/xrpcafe/',390],['/contact/',1100],['/contact/',900]]){
+  await page.setViewportSize({width:w,height:960});await page.goto(base+p);const stops=[];
+  for(let i=0;i<10;i++){await page.keyboard.press('Tab');stops.push(await page.evaluate(()=>({tag:document.activeElement.tagName,text:(document.activeElement.getAttribute('aria-label')||document.activeElement.innerText||document.activeElement.name).slice(0,120),y:scrollY,top:document.activeElement.getBoundingClientRect().top})));if(i===7||i===8)await page.screenshot({path:out+'order-'+key(p)+w+'-'+i+'.png'});}
+  records.push({kind:'focus-order',p,w,stops});
+ }
+ await page.setViewportSize({width:1440,height:960});await page.goto(base+'/toolbox/');await page.locator('.tool-picker button').nth(1).click();await page.getByRole('button',{name:'Add color'}).click();await page.getByRole('button',{name:'Remove color 5',exact:true}).focus();await page.keyboard.press('Space');const removed=await page.evaluate(()=>({active:document.activeElement.tagName,selected:document.activeElement.getAttribute('aria-label')}));await page.keyboard.press('Tab');const next=await page.evaluate(()=>({text:document.activeElement.innerText,aria:document.activeElement.getAttribute('aria-label')}));records.push({kind:'remove-focus',removed,next});
+ await ctx.grantPermissions(['clipboard-read','clipboard-write']);await page.goto(base+'/toolbox/agents/');const pres=await page.locator('pre.code').all();const copies=[];
+ for(let i=0;i<pres.length;i++){const pre=pres[i];await pre.scrollIntoViewIfNeeded();await pre.evaluate(e=>{const r=document.createRange();r.selectNodeContents(e);getSelection().removeAllRanges();getSelection().addRange(r);});await page.keyboard.press('Meta+C');const actual=await page.evaluate(()=>navigator.clipboard.readText());copies.push({label:await pre.getAttribute('aria-label'),text:actual,lines:actual.split('\n').length});}
+ records.push({kind:'command-copy',buttons:await page.locator('main button').count(),copies});
