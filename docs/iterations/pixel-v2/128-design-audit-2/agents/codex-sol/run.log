/* the exported sheets' face: the app sets its client pages in Helvetica, the one place on
   the site without a pixel face (Palette's swatch sheet, Specimen's labels) */
.demo{--face-sheet:'Helvetica Neue',Helvetica,Arial,sans-serif}
<script lang="ts">
  import type { Snippet } from 'svelte'

  /** A settings row: the row's content, then its state in brackets — `[on]`. */
  let {
    on,
    onchange,
    name,
    children,
    title,
  }: {
    on: boolean
    onchange: (v: boolean) => void
    /** the switch's accessible name: the row's own words, without its chips or swatches */
    name: string
    children?: Snippet
    title?: string
  } = $props()
  // A row is a div, not a label (0207): rows carry buttons (format chips), which a label may not
  // hold, and a label named the switch with every chip's text ("Web JPEG PNG SVG"). A click on the
  // row toggles it as a label would; a click on a chip is the chip's. The keyboard has the switch.
  function click(e: MouseEvent) {
    if (!(e.target as Element).closest('button, input')) onchange(!on)
  }
</script>

<!-- svelte-ignore a11y_click_events_have_key_events, a11y_no_static_element_interactions -->
<div class="switch lbl" class:on {title} onclick={click}>
  <input type="checkbox" role="switch" class="sr-only" checked={on} aria-label={name} onchange={() => onchange(!on)} />
  <span class="row">{@render children?.()}</span>
  <span class="state" aria-hidden="true">[{on ? 'on' : 'off'}]</span>
</div>
<script lang="ts">
  /**
   * Preview plate picker: light or dark ground behind the artwork previews —
   * reversed (white/off-white) logos are invisible on the light plate.
   */
  let { dark, onchange }: { dark: boolean; onchange: (v: boolean) => void } = $props()
</script>

<div role="group" aria-label="Preview background" style="display: inline-flex; gap: var(--s1); align-items: center">
  <span class="lbl dim" style="margin-inline-end: var(--s1)">Plate</span>
  <button
    type="button"
    class="swatch-chip plate-light"
    class:on={!dark}
    aria-pressed={!dark}
    aria-label="Light preview background"
    title="Light plate"
    onclick={() => onchange(false)}
  ></button>
  <button
    type="button"
    class="swatch-chip plate-dark"
    class:on={dark}
    aria-pressed={dark}
    aria-label="Dark preview background"
    title="Dark plate (for reversed logos)"
    onclick={() => onchange(true)}
  ></button>
</div>
<script lang="ts">
  // A block of commands or JSON on the inverted plate. Text is set in Jersey, the site's
  // reading face, because the mono role is uppercase and a command is not. A long line
  // wraps, its continuation indented two characters, so nothing scrolls sideways (0200);
  // each line is its own block, so copying keeps the line breaks. The text is a
  // prop, not children: Svelte collapses a snippet's newlines before they reach a <pre>.
  // A trailing `# comment` on a line is dimmed (0092); on a phone it drops under its
  // command and the spaces that align it are hidden. Short words (flags, values) never
  // break inside, so `--out` stays whole; a long path or JSON array breaks after a / , or :
  // first, and anywhere only past that. A wrapped line hangs under its own indent, so a
  // nested JSON key's continuation sits right of the key, not left of it (0206).
  let { text, label }: { text: string; label?: string } = $props();
  const lines = $derived(text.split('\n').map((line) => {
    const i = line.search(/\s#\s/);
    const code = i < 0 ? line : line.slice(0, i).trimEnd();
    // a lone `.` or other one-character word stays on the line with the word before it
    const words: string[] = [];
    for (const w of code.split(/(\s+)/).filter(Boolean)) {
      if (w.length === 1 && !/\s/.test(w) && words.length > 1 && /^\s+$/.test(words.at(-1)!)) { const sp = words.pop()!; words.push(words.pop()! + sp + w); }
      else words.push(w);
    }
    const lead = line.length - line.trimStart().length;
    return { words, lead, pad: i < 0 ? '' : line.slice(code.length, i + 1), note: i < 0 ? '' : line.slice(i + 1) };
  }));
</script>
<pre class="code body panel" role={label ? 'figure' : undefined} aria-label={label}>{#each lines as l}<span class="ln" style:--lead={l.lead || undefined}>{#each l.words as w}{#if /^\s+$/.test(w)}{w}{:else if w.length > 24}{#each w.split(/(?<=[/,:])/) as part, k}{#if k}<wbr />{/if}{#if part.length > 24}{part}{:else}<span class="w">{part}</span>{/if}{/each}{:else}<span class="w">{w}</span>{/if}{/each}{#if l.note}<span class="pad">{l.pad}</span><span class="c">{l.note}</span>{/if}</span>{/each}</pre>

