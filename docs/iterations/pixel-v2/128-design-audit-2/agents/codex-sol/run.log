+ for(const [p,selector] of [['/','a.cta-hint'],['/','a.card'],['/','a.quiet-link'],['/work/','a.cta-row'],['/toolbox/','a[href^="/download/"]'],['/toolbox/agents/','.jump a'],['/toolbox/lockup/','.page-foot a']]){
+  await page.goto(base+p);const target=page.locator(selector).first();await target.scrollIntoViewIfNeeded();await page.mouse.move(1,950);const rest=await target.evaluate(e=>({bg:getComputedStyle(e).backgroundColor,color:getComputedStyle(e).color,transform:getComputedStyle(e).transform}));await target.hover();const hover=await target.evaluate(e=>({bg:getComputedStyle(e).backgroundColor,color:getComputedStyle(e).color,transform:getComputedStyle(e).transform}));await page.mouse.down();const press=await target.evaluate(e=>({bg:getComputedStyle(e).backgroundColor,color:getComputedStyle(e).color,transform:getComputedStyle(e).transform}));await page.screenshot({path:out+'press-'+key(p)+selector.replace(/[^a-z]/gi,'').slice(0,25)+'.png'});await page.mouse.move(1,950);await page.mouse.up();rows.push({kind:'states',p,selector,rest,hover,press});
+ }
+ for(const p of ['/work/parc/','/work/xrpcafe/','/work/do-androids-dream/']){await page.goto(base+p);const button=page.locator('.clip button').first();await button.focus();await page.keyboard.press('Enter');await page.waitForTimeout(400);const play={label:await button.getAttribute('aria-label'),paused:await page.locator('.clip video').first().evaluate(v=>v.paused),focused:await button.evaluate(e=>e===document.activeElement)};await page.keyboard.press('Space');await page.waitForTimeout(100);rows.push({kind:'video',p,play,pause:{label:await button.getAttribute('aria-label'),paused:await page.locator('.clip video').first().evaluate(v=>v.paused),focused:await button.evaluate(e=>e===document.activeElement)}});}
+ await fs.writeFile(out+'final-checks.json',JSON.stringify(rows,null,2));return rows;
