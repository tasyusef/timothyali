    49	  const gallerySizes = (share: number, tiles: boolean) => `(min-width: 901px) calc((${FRAME.desk} - 32px) * 2 / 3 * ${share}), (min-width: 701px) calc(${FRAME.desk} * ${share}), ${phoneSize(tiles)}`;
    50	  const heroSizes = (share: number, tiles: boolean) => `(min-width: 701px) calc(${FRAME.desk} * ${share}), ${phoneSize(tiles)}`;
    51	  // A point's text is held in view only while it fits under the chrome; taller text scrolls
    52	  // with the page, or its last lines would stay hidden until the point's screens ran out.
    53	  // (the chrome is --chrome-height; the gap above it is --s4, and as much is kept below)
    54	  function hold(node: HTMLElement) {
    55	    const check = () => {
    56	      const chrome = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--chrome-height')) || 96;
    57	      node.classList.toggle('hold', node.offsetHeight <= window.innerHeight - chrome - 2 * 4 * U);
    58	    };
    59	    check(); document.fonts?.ready.then(check);
    60	    const ro = new ResizeObserver(check); ro.observe(node); window.addEventListener('resize', check);
    61	    return { destroy: () => { ro.disconnect(); window.removeEventListener('resize', check); } };
    62	  }
