     6	.nav-chrome{position:sticky;top:0;z-index:var(--z-nav);background:var(--paper)}
     7	.nav-chrome.collapsed{top:calc(-1 * var(--header-height))}
     8	.nav-chrome:focus-within{top:0}
     9	
    10	.skip-link{position:absolute;z-index:var(--z-skip);top:var(--s1);left:var(--gutter);padding:var(--s1) var(--s2);background:var(--fg);color:var(--paper);transform:translateY(-200%)}
    11	.skip-link:focus{transform:none}
    12	
    13	/* the header sits one above the status strip: its settings menu opens down over the strip (0201) */
    14	.site-header{position:relative;z-index:calc(var(--z-chrome) + 1);display:grid;grid-template-columns:auto 1fr auto;gap:var(--s4);align-items:start;height:64px;padding:var(--s1) var(--gutter) 0}
    15	.wordmark{font-size:43px;line-height:43px;white-space:nowrap}
    16	.path{display:flex;align-items:center;min-width:0;max-width:100%}
    17	.path .path-text{overflow:hidden;min-width:0}
    18	.site-header nav{display:flex;gap:var(--s1);margin-top:var(--s1);justify-self:end}
    19	/* Centred ink, not centred boxes (0097): PARC Pixel and Press Start sit 1px high in their line
    20	   and carry a 2px trailing bearing, so a button's padding is 9/7 (or 17/15, 25/23) and 2 less on
    21	   the right. Box heights are unchanged. */
    22	.site-header nav a{display:block;padding:var(--pad-s)}
    23	.site-header nav a b{font-weight:400;opacity:var(--dim);margin-right:var(--s1)}
    24	.site-header nav a[aria-current]{background:var(--accent);color:var(--on-accent)}
    25	@media(hover:hover){.site-header nav a:hover{background:var(--fg);color:var(--paper)}}
    26	.site-header nav a[aria-current] b{opacity:1}@media(hover:hover){.site-header nav a:hover b{opacity:1}}
    27	
    28	/* Settings (0168): a 32px cog block at the end of the nav, 8px after Toolbox like the links'
    29	   own gap; it opens a menu of the two toggles, an inverted block with no rules (0049). */
    30	.settings{position:relative;margin:var(--s1) 0 0 calc(var(--s1) - var(--s4))}
    31	.settings:not(.ready){visibility:hidden}
    32	.settings .cog{display:block;padding:var(--s1)}
    33	.settings .cog svg{display:block}
    34	.settings .cog[aria-expanded=true]{background:var(--fg);color:var(--paper)}@media(hover:hover){.settings .cog:hover{background:var(--fg);color:var(--paper)}}
    35	.settings-menu{position:absolute;top:calc(100% + var(--s1));right:0;display:flex;flex-direction:column;width:192px;background:var(--fg);color:var(--paper)}
    36	.settings-menu[hidden]{display:none}
    37	.settings-menu button{display:flex;justify-content:space-between;padding:var(--pad-s);text-align:left}
    38	.settings-menu button:focus-visible{background:var(--accent);color:var(--on-accent)}@media(hover:hover){.settings-menu button:hover{background:var(--accent);color:var(--on-accent)}}
    39	
    40	/* One flexible gap, not space-between: leftover width split four ways lands the items on
    41	   thirds of a pixel and blurs the bitmap face (0089). The place sits with the path, the
    42	   clock at the right; the scroll count, coordinates and SYS.OK are gone (0192). */
    43	.readout{position:relative;z-index:var(--z-chrome);display:flex;gap:var(--s4);padding:var(--s1) var(--gutter);height:32px;overflow:hidden;white-space:nowrap}
    44	.readout .st-clock{margin-left:auto}
    45	.readout>span{flex:none;opacity:var(--dim)}
    46	.readout .path{opacity:1;flex:0 1 auto;min-width:0}
    47	.readout .path-text{white-space:nowrap;text-overflow:ellipsis} /* a path with no room ends in the strip's own … rather than mid-word (0105) */
    48	.readout .path .decode{display:inline} /* inline, not inline-block, or the ellipsis cannot reach into it */
    49	.readout .path{font-size:inherit;line-height:inherit}
    50	/* The strip never shrinks below 16px. It sheds items instead (0072, 0192): ≤900 Denver goes
    51	   and the path keeps only its last segment; ≤700 the strip itself goes (0185). */
    52	.path-short{display:none}

