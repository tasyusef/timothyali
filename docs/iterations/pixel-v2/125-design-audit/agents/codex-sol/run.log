            <span class="chips lbl" role="group" aria-label={`${r.label} size`}>{#each ['L', 'M', 'S'] as s, i (s)}<button type="button" class="chip" aria-pressed={r.step === i} onclick={() => (r.step = i)}>{s}</button>{/each}</span>
