@media(hover:hover){.demo .steps button:not(:disabled):not([aria-current]):hover{opacity:1;background:var(--fg);color:var(--paper)}}

/* the two button voices */
.demo .demo-act{display:inline-flex;align-items:center;gap:var(--s2);padding:9px 12px 7px 16px;background:var(--accent);color:var(--on-accent);white-space:nowrap}
.demo .demo-act:focus-visible{background:var(--fg);color:var(--paper)}@media(hover:hover){.demo .demo-act:hover:not(:disabled){background:var(--fg);color:var(--paper)}}
.demo .demo-act:disabled{background:var(--surface-card);color:var(--fg);opacity:var(--dim);cursor:default}
.demo .btn{display:inline-flex;align-items:center;gap:var(--s1);padding:var(--pad-s);white-space:nowrap;min-width:0;flex:none}
.demo .btn:focus-visible,.demo .btn[aria-pressed=true]{background:var(--fg);color:var(--paper)}@media(hover:hover){.demo .btn:hover:not(:disabled){background:var(--fg);color:var(--paper)}}
