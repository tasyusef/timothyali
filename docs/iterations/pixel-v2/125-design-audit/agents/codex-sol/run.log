/* ------------------------------------------------------------------
   Site chrome — the sticky header/status wrapper and the global footer.
   Heights are literal because they are the chrome's geometry, not spacing:
   64 header, 32 status strip, 104/48/32 on phones. All are 8px multiples.
   ------------------------------------------------------------------ */
.nav-chrome{position:sticky;top:0;z-index:var(--z-nav);background:var(--paper)}
.nav-chrome.collapsed{top:calc(-1 * var(--header-height))}
.nav-chrome:focus-within{top:0}

.skip-link{position:absolute;z-index:var(--z-skip);top:var(--s1);left:var(--gutter);padding:var(--s1) var(--s2);background:var(--fg);color:var(--paper);transform:translateY(-200%)}
.skip-link:focus{transform:none}

/* the header sits one above the status strip: its settings menu opens down over the strip (0201) */
.site-header{position:relative;z-index:calc(var(--z-chrome) + 1);display:grid;grid-template-columns:auto 1fr auto;gap:var(--s4);align-items:start;height:64px;padding:var(--s1) var(--gutter) 0}
.wordmark{font-size:43px;line-height:43px;white-space:nowrap}
.path{display:flex;align-items:center;min-width:0;max-width:100%}
.path .path-text{overflow:hidden;min-width:0}
.site-header nav{display:flex;gap:var(--s1);margin-top:var(--s1);justify-self:end}
/* Centred ink, not centred boxes (0097): PARC Pixel and Press Start sit 1px high in their line
   and carry a 2px trailing bearing, so a button's padding is 9/7 (or 17/15, 25/23) and 2 less on
   the right. Box heights are unchanged. */
.site-header nav a{display:block;padding:var(--pad-s)}
.site-header nav a b{font-weight:400;opacity:var(--dim);margin-right:var(--s1)}
.site-header nav a[aria-current]{background:var(--accent);color:var(--on-accent)}
@media(hover:hover){.site-header nav a:hover{background:var(--fg);color:var(--paper)}}
.site-header nav a[aria-current] b{opacity:1}@media(hover:hover){.site-header nav a:hover b{opacity:1}}

/* Settings (0168): a 32px cog block at the end of the nav, 8px after Toolbox like the links'
   own gap; it opens a menu of the two toggles, an inverted block with no rules (0049). */
.settings{position:relative;margin:var(--s1) 0 0 calc(var(--s1) - var(--s4))}
.settings:not(.ready){visibility:hidden}
.settings .cog{display:block;padding:var(--s1)}
.settings .cog svg{display:block}
.settings .cog[aria-expanded=true]{background:var(--fg);color:var(--paper)}@media(hover:hover){.settings .cog:hover{background:var(--fg);color:var(--paper)}}
.settings-menu{position:absolute;top:calc(100% + var(--s1));right:0;display:flex;flex-direction:column;width:192px;background:var(--fg);color:var(--paper)}
.settings-menu[hidden]{display:none}
.settings-menu button{display:flex;justify-content:space-between;padding:var(--pad-s);text-align:left}
.settings-menu button:focus-visible{background:var(--accent);color:var(--on-accent)}@media(hover:hover){.settings-menu button:hover{background:var(--accent);color:var(--on-accent)}}

/* One flexible gap, not space-between: leftover width split four ways lands the items on
   thirds of a pixel and blurs the bitmap face (0089). The place sits with the path, the
   clock at the right; the scroll count, coordinates and SYS.OK are gone (0192). */
.readout{position:relative;z-index:var(--z-chrome);display:flex;gap:var(--s4);padding:var(--s1) var(--gutter);height:32px;overflow:hidden;white-space:nowrap}
.readout .st-clock{margin-left:auto}
.readout>span{flex:none;opacity:var(--dim)}
.readout .path{opacity:1;flex:0 1 auto;min-width:0}
.readout .path-text{white-space:nowrap;text-overflow:ellipsis} /* a path with no room ends in the strip's own … rather than mid-word (0105) */
.readout .path .decode{display:inline} /* inline, not inline-block, or the ellipsis cannot reach into it */
.readout .path{font-size:inherit;line-height:inherit}
/* The strip never shrinks below 16px. It sheds items instead (0072, 0192): ≤900 Denver goes
   and the path keeps only its last segment; ≤700 the strip itself goes (0185). */
.path-short{display:none}
@media(max-width:900px){.st-city,.path-full{display:none}.path-short{display:inline}}
/* The nav numbers go at 900, not only 700 (PX-49): between 702 and 776 the four numbered
   labels ran up to 57px past the gutter and the page scrolled sideways. */
@media(max-width:900px){.site-header nav a b{display:none}}
/* With the cog (0168) the row ran 19px into the right gutter at 702: the links lose their
   8px gaps here; their own 16px padding still keeps the labels apart. */
@media(max-width:900px) and (min-width:701px){.site-header nav{gap:0}}

.global-footer{display:grid;grid-template-columns:1fr;gap:var(--s2);align-items:center;padding:var(--s2) var(--gutter) var(--s3)}

@media(max-width:700px){
  /* 104 = 8 padding + 48 wordmark row + 8 gap + 32 nav row + 8 padding (decision 0070) */
  .site-header{grid-template-columns:auto 1fr;grid-template-rows:48px 32px;gap:var(--s1);height:104px;padding:var(--s1) var(--gutter)}
  .wordmark{align-self:end}
  .site-header nav{grid-column:1/-1;grid-row:2;justify-self:stretch;gap:0;margin:0 calc(-1*var(--gutter))}
  /* the cog moves up beside the wordmark, its icon on the gutter */
  .settings{grid-column:2;grid-row:1;justify-self:end;align-self:center;margin:0 calc(-1*var(--s1)) 0 0}
  /* Four equal quarters (Toolbox is the fourth item, 0092); the first three are rounded
     to whole 2px cells and the last takes the remainder, centring its label inside an
     even-width track so the text still lands on whole pixels (0089). */
  .site-header nav a{flex:none;width:round(down,calc(100% / 4),2px);text-align:center;padding:9px 0 7px 2px}
  .site-header nav a:last-child{flex:1 1 0;min-width:0;width:auto;white-space:nowrap;display:grid;grid-template-columns:round(down,100%,2px)}
  /* Four numbered labels do not fit 320: the numbers go, the words stay (0092). */
  /* no status strip on phones (0185): there it was a clipped path and a scroll count, 32px of
     decoration on every page; the header alone is the chrome, 104px */
  .readout{display:none}
  .global-footer{padding:var(--s3) var(--gutter) var(--s4)}
}
@media(max-width:420px){
  /* CONTACT and TOOLBOX are 82px each, wider than a quarter of 320: below the phone
     floor the four items take their own widths and share what is left (0092). */
  /* The tracks are weighted by their words (INDEX 6, WORK 5, CONTACT 8, the rest TOOLBOX) and
     floored to 2px, so every label starts on a whole pixel, and the row keeps an 8px margin;
     shared out by flex they fell on quarter pixels and INDEX sat 6.5px from the edge (0206). */
  .site-header nav{padding:0 var(--s1)}
  .site-header nav a{flex:none;display:block;padding:9px 0 7px 2px}
  .site-header nav a:nth-child(1){width:round(down,calc(100% * 6 / 26),2px)}
  .site-header nav a:nth-child(2){width:round(down,calc(100% * 5 / 26),2px)}
  .site-header nav a:nth-child(3){width:round(down,calc(100% * 8 / 26),2px)}
}
/* On a touch screen the chrome's 32px rows reach 44px to a finger without changing the look:
   the nav and the cog grow an invisible margin, and the menu rows grow (0206). */
@media(pointer:coarse){
  .site-header nav a,.settings .cog{position:relative}
  .site-header nav a::after{content:'';position:absolute;inset:-6px 0}
  .settings .cog::after{content:'';position:absolute;inset:-6px}
  .settings-menu button{padding-top:15px;padding-bottom:13px}
}

/* PX-22: Home's footer sits a step looser; its toggles moved to the nav's cog (0168). */
.home-footer{padding-top:var(--s4);padding-bottom:var(--s4)}

.home-footer>.dim{text-wrap:balance}

/* --- press (0099) --- the pressed surface is the accent; see blocks.css. Last, so it
   wins over every hover above at equal specificity. */
.site-header nav a:active,.settings .cog:active,.settings-menu button:active,.skip-link:active{background:var(--accent);color:var(--on-accent)}
.site-header nav a:active b{color:inherit;opacity:1}
/* ------------------------------------------------------------------
   The app's blocks, scoped under `.demo` so the four Toolbox examples on the
   landing page read as the app's screens: the readout strip, a stage beside a
   rail, settings rows with a bracketed state, chips, dithered fields, mats and
   plates, the plan tree, the file stack, and the bottom bar. Copied from
   GRIDFORM Studio's `styles/blocks.css` and `chrome.css` (0095); the values
   are the site's tokens, which the app shares. Sizes are geometry: 32px rows,
   24px swatches, a 376px rail (47 cells, the app's).
   ------------------------------------------------------------------ */
.demo{scroll-margin-top:var(--s2);--rim:var(--tint-rim);display:flex;flex-direction:column;background:var(--paper);color:var(--fg);min-width:0}

/* the readout: the path, then what the screen is doing, one flexible gap */
.demo .demo-readout{display:flex;gap:var(--s4);height:32px;padding:var(--s1) var(--s3);white-space:nowrap;overflow:hidden}
/* the count is pushed right, not placed after the path: the tilde's advance is fractional at 12.5 */
.demo .demo-readout>span{flex:none;opacity:var(--dim);margin-left:auto}
.demo .demo-readout .demo-path{opacity:1;margin-left:0;flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}

/* a stage beside a rail */
.demo .split{display:grid;grid-template-columns:minmax(0,1fr) 376px;align-items:start}
.demo .stage{display:flex;flex-direction:column;gap:var(--s2);min-width:0;padding:var(--s2) var(--s3);min-height:416px}
.demo .stage.center{align-items:center;justify-content:center}
.demo .rail{display:flex;flex-direction:column;gap:var(--s3);min-width:0;padding:var(--s2) var(--s3) var(--s2) 0}
.demo .rail-section{display:flex;flex-direction:column}
.demo .rail-section.tight{gap:var(--s1)} /* a heading over one control (0210; was an inline style) */
.demo .rail-head{display:flex;justify-content:space-between;align-items:baseline;gap:var(--s2);padding:var(--s1) 0}
.demo .rail p.lbl{padding-top:var(--s1)}

/* the bottom bar: the way back left, steps or a count centre, the action right. The bar is an
   even number of pixels wide and its items are too (2px glyph pixels, even padding), so the two
   gaps `space-between` leaves are whole pixels and the centre lands on one (0089, 0210). */
.demo .toolbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--s2);padding:var(--s2) var(--s3);width:round(down,100%,2px)}
.demo .steps{display:flex;gap:var(--s1)}
