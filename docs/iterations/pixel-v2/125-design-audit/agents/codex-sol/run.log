.demo .btn[aria-pressed=true] .mono,.demo .btn:disabled .mono{color:inherit}@media(hover:hover){.demo .btn:hover:not(:disabled) .mono{color:inherit}}
.demo .plus{color:var(--accent-text)}

/* chips: a choice; the chosen one is the accent block */
.demo .chips{display:flex;flex-wrap:wrap;gap:var(--s1)}.demo .chips.fill .chip{flex:1}
