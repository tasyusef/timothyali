<script lang="ts">
  import DemoReadout from './DemoReadout.svelte';
  import DemoToolbar from './DemoToolbar.svelte';
  // Palette: the artwork in the centre, the colours and the outputs in the rail, and
  // the files it writes, each one previewable in place. The CSS, SCSS and tokens text
  // is generated by the app's own exporters (`plan.ts`); the swatch sheet is the app's
  // client-deck page, drawn here in HTML.
  import AppToggle from './AppToggle.svelte';
  import SwatchDot from './SwatchDot.svelte';
  import { css, scss, tokensJSON, aseBytes, hexToOklchString, cmyk, normalizedHex, fileSize, pad2, type PaletteEntry } from './plan';

  let name = $state('Acme');
  let colors = $state<PaletteEntry[]>([{ name: 'Field', hex: '#174c43' }, { name: 'Flare', hex: '#ff683b' }, { name: 'Signal', hex: '#f2d600' }, { name: 'Paper', hex: '#f4f1e7' }]);
  let out = $state({ css: true, tokens: true, ase: true, sheet: true });
  let preview: string | null = $state(null);
  const spare = ['#342a67', '#bbdd96', '#11110e', '#4f8fb0'];
  const token = $derived(name.trim() === '' ? 'Palette' : name.trim().replace(/\s+/g, '_'));
  const files = $derived.by(() => {
    const list: string[] = [];
    if (out.css) list.push(`${token}.css`, `${token}.scss`);
    if (out.tokens) list.push(`${token}.tokens.json`);
    if (out.ase) list.push(`${token}.ase`);
    if (out.sheet) list.push(`${token}_Swatches.pdf`, `${token}_Swatches.png`);
    return list;
  });
  // the preview is held by kind, not by filename, so renaming keeps it open
  const kind = (f: string) => f.replace(token, '');
  const active = $derived(preview && files.find((f) => kind(f) === preview) ? preview : null);
  const text = $derived(active === '.css' ? css(colors) : active === '.scss' ? scss(colors) : active === '.tokens.json' ? tokensJSON(colors) : null);
  const at = (i: number) => colors[i % colors.length].hex;
  const setHex = (i: number, v: string) => { const h = normalizedHex(v); if (h) colors[i].hex = h; };
</script>
