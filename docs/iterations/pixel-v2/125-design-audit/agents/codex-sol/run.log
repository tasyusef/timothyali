/* ------------------------------------------------------------------
   Layer 3 — named type roles.

   Sizes are literals on purpose: every one is a row of the cell table at
   the top of app.css (cells per em × cell size), so the table is the
   documentation and a token would hide the arithmetic. Only the face
   stacks and the ladders are named.

   role         face            size / line-height ladder
   .blackletter Jacquard 24     family only, line-height 1
   .display-xl  (inherited)     258 → 172 (≤1100) → 129 (≤700) → 86 (≤420)
   .display     PARC Pixel Bold 55/56 → 41.25/48 (≤700)   (cell 4 → cell 3)
   .display-s   PARC Pixel Bold 41.25/48 → 27.5/32 (≤700)  (cell 3 → cell 2)
   .display-title PARC Pixel Bold 110/112 → 82.5/88 (≤1100) → 55/56 (≤900) → 41.25/48 (≤700):
                the inner pages' titles (study, tool, CLI & MCP; 0210). `.lesser` starts a rung
                down above 900; `.small` (set by fitWord) steps the text a rung down
   .lead        Jersey 15       54/64 → 27/32 (≤700)
   .body        Jersey 15       27/32
   .lbl         PARC Pixel      12.5/16, uppercase        (cell 2)
   .mono        Press Start 2P  16/16, uppercase, nowrap
   .read        IBM Plex Mono   18/32, smoothed: the case-study reading text (0136, 0137)
   .read-s      IBM Plex Mono   14/24, smoothed: small reading text (0210); .phone-read turns a
                                label into it below 700 (captions, download notes)
   .dim         —               opacity only
   ------------------------------------------------------------------ */
.blackletter{font-family:var(--face-blackletter);font-weight:400;line-height:1}
.display{font-family:var(--face-display);font-weight:700;font-size:55px;line-height:56px;text-transform:uppercase}
.display-s{font-family:var(--face-display);font-weight:700;font-size:41.25px;line-height:48px;text-transform:uppercase}
.display-title{font-family:var(--face-display);font-weight:700;font-size:110px;line-height:112px;text-transform:uppercase}
.display-title.lesser{font-size:82.5px;line-height:88px}
.display-title .decode{display:inline;white-space:normal} /* a title may wrap between words */
/* the fit step applies to the text only; the probe (aria-hidden) keeps the base size, or it would
   measure itself small and flip back. A block, so its own line height sets the lines (PX-49). */
.display-title.small>:not([aria-hidden]){display:block;font-size:82.5px;line-height:88px}
.body{font-family:var(--face-text);font-size:27px;line-height:32px}
.lead{font-family:var(--face-text);font-size:54px;line-height:64px}
.lbl{font-family:var(--face-label);font-size:12.5px;line-height:16px;text-transform:uppercase}
.mono{font-family:var(--face-mono);font-size:16px;line-height:16px;text-transform:uppercase;white-space:nowrap}
/* the one smoothed face: every other role is a bitmap and :root turns smoothing off (base.css) */
.read{font-family:var(--face-read);font-size:18px;line-height:32px;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
@media(max-width:700px){.read{font-size:16px;line-height:24px}} /* 37 characters a line at 390, not 33 (0206) */
.read-s{font-family:var(--face-read);font-size:14px;line-height:24px;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
@media(max-width:700px){.phone-read{font-family:var(--face-read);font-size:14px;line-height:24px;text-transform:none;letter-spacing:0;-webkit-font-smoothing:antialiased}}
/* An inline arrow or value in another face's line sits on the line top, where a flex Cta
   would put it; on the baseline its 16px box hangs 4px lower and the line grows to 20 (0089). */
:where(.lbl,.body,.display,.lead,.read) .mono{vertical-align:top}
.dim{opacity:var(--dim)}

/* The one-word display size. Carries no face of its own — it is always
   worn with .blackletter — so it must come after .blackletter to win the
   line-height. Replaces the three route-local `.xl` copies. Jacquard's sizes
   are 43 × cells, never a multiple of 8, so the line box is the next unit up
   (258 → 264, 172 → 176, 129 → 136) and what follows stays on the grid; the
   glyph sits 3px (or 2) below the box top, on whole pixels (0089). */
.display-xl{font-size:258px;line-height:264px;display:block}

@media(max-width:1100px){.display-xl{font-size:172px;line-height:176px}.display-title{font-size:82.5px;line-height:88px}.display-title.lesser{font-size:55px;line-height:56px}.display-title.small>:not([aria-hidden]){font-size:55px;line-height:56px}}
@media(max-width:900px){.display-title,.display-title.lesser{font-size:55px;line-height:56px}.display-title.small>:not([aria-hidden]){font-size:41.25px;line-height:48px}}
@media(max-width:700px){
  .display-xl{font-size:129px;line-height:136px}
  .display{font-size:41.25px;line-height:48px}
  .display-s{font-size:27.5px;line-height:32px}
  .lead{font-size:27px;line-height:32px}
  .display-title,.display-title.lesser{font-size:41.25px;line-height:48px}
  .display-title.small>:not([aria-hidden]){font-size:27.5px;line-height:32px}
}
/* “building.” is 372px at 129, wider than a 375 phone (0075) */
@media(max-width:420px){.display-xl{font-size:86px;line-height:88px}}
<script lang="ts">
  // A block of commands or JSON on the inverted plate. Text is set in Jersey, the site's
  // reading face, because the mono role is uppercase and a command is not. A long line
  // wraps, its continuation indented two characters, so nothing scrolls sideways (0200);
  // each line is its own block, so copying keeps the line breaks. The text is a
  // prop, not children: Svelte collapses a snippet's newlines before they reach a <pre>.
  // A trailing `# comment` on a line is dimmed (0092); on a phone it drops under its
  // command and the spaces that align it are hidden. Short words (flags, values) never
  // break inside, so `--out` stays whole; a long path or JSON array breaks after a / , or :
  // first, and anywhere only past that. A wrapped line hangs under its own indent, so a
  // nested JSON key's continuation sits right of the key, not left of it (0206).
  let { text, label }: { text: string; label?: string } = $props();
  const lines = $derived(text.split('\n').map((line) => {
    const i = line.search(/\s#\s/);
    const code = i < 0 ? line : line.slice(0, i).trimEnd();
    // a lone `.` or other one-character word stays on the line with the word before it
    const words: string[] = [];
    for (const w of code.split(/(\s+)/).filter(Boolean)) {
      if (w.length === 1 && !/\s/.test(w) && words.length > 1 && /^\s+$/.test(words.at(-1)!)) { const sp = words.pop()!; words.push(words.pop()! + sp + w); }
      else words.push(w);
    }
    const lead = line.length - line.trimStart().length;
    return { words, lead, pad: i < 0 ? '' : line.slice(code.length, i + 1), note: i < 0 ? '' : line.slice(i + 1) };
  }));
</script>
<pre class="code body panel" role={label ? 'figure' : undefined} aria-label={label}>{#each lines as l}<span class="ln" style:--lead={l.lead || undefined}>{#each l.words as w}{#if /^\s+$/.test(w)}{w}{:else if w.length > 24}{#each w.split(/(?<=[/,:])/) as part, k}{#if k}<wbr />{/if}{#if part.length > 24}{part}{:else}<span class="w">{part}</span>{/if}{/each}{:else}<span class="w">{w}</span>{/if}{/each}{#if l.note}<span class="pad">{l.pad}</span><span class="c">{l.note}</span>{/if}</span>{/each}</pre>

