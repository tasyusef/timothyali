.demo .stack-row .text,.demo .stack-row .figures{background:var(--paper);padding:0 var(--s1);min-width:0;display:flex;flex-direction:column}
.demo .stack-row .text .body,.demo .stack-row .text .lbl{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.demo .figure{display:grid;grid-template-columns:minmax(0,1fr) 72px 56px;gap:var(--s1);align-items:center}
.demo .figure .body{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.demo .figure .lbl{text-align:right;white-space:nowrap}

/* press (0099): the pressed surface is the accent, as everywhere on the site. A settings
   row takes the cell at its sides with offset shadows, into the rail's padding. */
.demo .btn:active:not(:disabled),.demo .chip:active:not(:disabled),.demo .steps button:active:not(:disabled),.demo .demo-act:active:not(:disabled),.demo button.tree-row:active,.demo .file-row:active,.demo .switch:active{background:var(--accent);color:var(--on-accent)}
.demo .btn:active:not(:disabled) .mono,.demo .switch:active .state,.demo .switch:active .plus,.demo .switch:active .dim{color:inherit;opacity:1}
.demo .switch:active{box-shadow:var(--s1) 0 0 var(--accent),calc(-1 * var(--s1)) 0 0 var(--accent)}
.demo .swatch-chip:active{outline:2px solid var(--accent);outline-offset:2px}
/* Convert's thumbnails arrive through the dither once encoded (0101). */
.motion .demo .stack-row .thumb img{animation:var(--wipe-in)}

/* a nowrap label */
.demo .nowrap{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}

/* code on the plate: the app's body face, as Code.svelte does on the site */
.demo pre.body{margin:0;white-space:pre;overflow-x:auto}

@media(max-width:1100px){.demo .split{grid-template-columns:minmax(0,1fr) 296px}.demo .switch .chips{flex-wrap:wrap}.demo .switch:has(.chips),.demo .switch:has(.chips) .row{align-items:flex-start}
  /* the wizard's three steps take their own row once the demo is narrower than the app */
  .demo .steps{order:-1;width:100%;justify-content:center;padding-bottom:var(--s1)}}
@media(max-width:900px){.demo .split{grid-template-columns:minmax(0,1fr) 376px}.demo .switch .chips{flex-wrap:nowrap}}
@media(max-width:700px){
  .demo .split{grid-template-columns:minmax(0,1fr)}
  .demo .stage{padding:var(--s2);min-height:0}
  .demo .rail{padding:var(--s2)}
  .demo .demo-readout,.demo .toolbar{padding:var(--s1) var(--s2)}
  .demo .toolbar{padding:var(--s2)}
  .demo .stack-row .figures{grid-column:1/-1}
  .demo .steps button{padding:9px 6px 7px 8px}
}
@media(max-width:420px){
  .demo .steps button span{display:none}
  .demo .steps button b{margin-right:0}
}

/* Touch (0206): on a touch screen the demo's controls reach 44px without changing the desktop
   look: chips, buttons, steps and rows grow to 44px tall, a swatch grows an invisible margin,
   and the slider's thumb is a 24×32 target around its 8×16 block. */
@media(pointer:coarse){
  .demo .chip,.demo .btn,.demo .steps button,.demo .demo-act,.demo .switch,.demo .file-row,.demo button.tree-row{min-height:44px}
  .demo .chip{min-width:44px}
  .demo .swatch-chip{position:relative}.demo .swatch-chip::after{content:'';position:absolute;inset:-10px}
  .demo input[type=range]{height:44px}
  .demo input[type=range]::-webkit-slider-thumb{width:24px;height:32px;margin-top:-15px;padding:8px;box-sizing:border-box;background-clip:content-box}
  .demo input[type=range]::-moz-range-thumb{width:24px;height:32px;padding:8px;box-sizing:border-box;background-clip:content-box}
}

/* Phones (0206): the readout drops its ~/Toolbox/ prefix below 420, where the path was cut
   mid-word; Convert's file name and source line wrap rather than clip the size the savings are
   measured against */
@media(max-width:420px){.demo .demo-readout .pre{display:none}}
@media(max-width:700px){.demo .stack-row .text .body,.demo .stack-row .text .lbl{white-space:normal;overflow-wrap:anywhere}}

/* small layout classes for what the examples wrote inline (0210) */
.demo .dest{width:100%;justify-content:space-between} /* DestinationRow */
.demo .start{align-self:flex-start}
.demo .swatches{display:inline-flex;gap:calc(var(--s1) / 2)}
.demo .range-row{display:flex;align-items:center;gap:var(--s2)}.demo .range-row input{flex:1}.demo .range-row .lbl{width:var(--s6);text-align:right}
/* the exported sheets' face: the app sets its client pages in Helvetica, the one place on
   the site without a pixel face (Palette's swatch sheet, Specimen's labels) */
.demo{--face-sheet:'Helvetica Neue',Helvetica,Arial,sans-serif}

