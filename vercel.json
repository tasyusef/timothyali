{
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "build",
  "routes": [
    { "src": "^/about/?$", "status": 308, "headers": { "Location": "/contact/" } },
    { "src": "^/blog/?$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/art/?$", "status": 308, "headers": { "Location": "/work/" } },
    { "src": "^/work/rowboat-racer/?$", "status": 308, "headers": { "Location": "/work/parc-site/" } },
    { "src": "^/work/gridform(-studio)?/?$", "status": 308, "headers": { "Location": "/work/" } },
    { "src": "^/(?!.*\\.)(.+[^/])$", "status": 308, "headers": { "Location": "/$1/" } },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "status": 404, "dest": "/not-found/" }
  ]
}
