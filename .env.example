# Server-only. Configure these in Vercel; never commit actual credentials.
# Comma-separated approved addresses. The legacy ADMIN_EMAIL also works.
ADMIN_EMAILS=
AUTH_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANALYTICS_SECRET=
# Existing CONTACT_FROM can supply the sender. RESEND_API_KEY, KV_REST_API_URL and KV_REST_API_TOKEN also work.
# Local tracking stays off unless explicitly enabled with a separate test database.
ANALYTICS_DEV=0
